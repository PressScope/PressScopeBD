# Server
PORT=8080
APP_ENV=development

# Valkey — single URI (supports redis://, rediss:// for TLS)
# Local:  redis://localhost:6379
# Aiven:  rediss://default:<password>@<host>:<port>
VALKEY_URL=redis://localhost:6379

# Stream configuration
VALKEY_STREAM_NAME=analytics:events
VALKEY_STREAM_MAX_LEN=100000
VALKEY_CONSUMER_GROUP=analytics-processors
VALKEY_CONSUMER_NAME=processor-1

# --- MotherDuck Configuration ---
# MOTHERDUCK_TOKEN=<your-token>
MOTHERDUCK_DB=Analytics